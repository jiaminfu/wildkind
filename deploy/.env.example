# ============================================================
# TIDEGLASS · 生产环境变量样例
# 用法：复制到 /etc/tideglass/tideglass.env 后改掉所有 CHANGE_ME
#   sudo install -m 640 -o root -g tideglass \
#        deploy/.env.example /etc/tideglass/tideglass.env
#   sudo nano /etc/tideglass/tideglass.env
# 这份文件由 systemd 的 EnvironmentFile 读入，不进 Git。
# ============================================================

# ---- 监听 ----
# Node 监听端口。Nginx 反代到它，不要对外暴露。
PORT=4600

# ---- 后台账号 ----
# 只在「首次生成数据」时生效：node app/server/seed.js
# 数据已存在时改这里无效——密码是 scrypt hash 存在 db.json 里的。
# 换密码的正确做法见部署手册 6.4「改后台密码」。
ADMIN_PASSWORD=CHANGE_ME_owner_strong_password
OPS_PASSWORD=CHANGE_ME_ops_strong_password

# ---- 跨域 ----
# 前后端同域部署（Nginx 同站反代）时留 * 也可以；
# 一旦前台换到别的域名，必须写成那个域名，否则任意站点都能带令牌调接口。
CORS_ORIGIN=*

# ---- 测试复位开关 ----
# 生产环境绝对不要设！不设时 /api/v1/__test/reset 这条路由根本不会被注册。
# 只有跑自动化测试的机器才设 ALLOW_TEST_RESET=1。
#ALLOW_TEST_RESET=1
