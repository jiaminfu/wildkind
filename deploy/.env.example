# ============================================================
# TIDEGLASS · 生产环境变量样例
#
# 两种用法，看清你要哪一种：
#   A. 宿主机 Node + systemd（install.sh 装的）
#      复制到 /etc/tideglass/tideglass.env 后改掉所有 CHANGE_ME
#      sudo install -m 640 -o root -g tideglass \
#           deploy/.env.example /etc/tideglass/tideglass.env
#   B. Docker（docker compose）
#      复制到 deploy/.env 后改，这份同时给 compose 做变量替换
#      cp deploy/.env.example deploy/.env
#
# 两种方式都不进 Git。
# ============================================================

# ---- 监听 ----
# 容器内 / 进程内监听端口。反代到它即可，不需要改。
PORT=4600

# ---- 对外暴露（仅 Docker 方式需要）----
# 默认只绑本机回环，公网摸不到 —— 这是配宿主机 Nginx + HTTPS 时的正确姿势。
# 无域名、或 80/443 已被别的容器占用时，改成下面两行：
#   BIND_ADDR=0.0.0.0
#   HOST_PORT=8080
# 然后 http://<公网IP>:8080/ 直接可用，不碰 80/443 一个字节。
#BIND_ADDR=127.0.0.1
#HOST_PORT=4600

# ---- 后台账号 ----
# 只在「首次生成数据」时生效：node app/server/seed.js
# 数据已存在时改这里无效——密码是 scrypt hash 存在 db.json 里的。
# 换密码的正确做法见部署手册 6.4「改后台密码」。
ADMIN_PASSWORD=CHANGE_ME_owner_strong_password
OPS_PASSWORD=CHANGE_ME_ops_strong_password

# ---- 跨域 ----
# 前后端同域部署（Nginx 同站反代）时留 * 也可以；
# 一旦前台换到别的域名，必须写成那个域名，否则任意站点都能带令牌调接口。
CORS_ORIGIN=*

# ---- 测试复位开关 ----
# 生产环境绝对不要设！不设时 /api/v1/__test/reset 这条路由根本不会被注册。
# 只有跑自动化测试的机器才设 ALLOW_TEST_RESET=1。
#ALLOW_TEST_RESET=1
