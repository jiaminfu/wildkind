# 统一换行符。
# Windows 上默认 autocrlf 会把 LF 改成 CRLF，而 deploy/*.sh 带 CRLF 后
# 在 Linux 上会报 "bad interpreter: /bin/bash^M" —— 部署脚本必须锁死 LF。
* text=auto eol=lf

*.sh      text eol=lf
*.conf    text eol=lf
*.service text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.css     text eol=lf
*.html    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
Dockerfile text eol=lf

# Windows 批处理必须是 CRLF，否则某些命令解析异常
*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制，别做任何行尾转换
*.png     binary
*.jpg     binary
*.jpeg    binary
*.webp    binary
*.gif     binary
*.ico     binary
*.woff2   binary
*.gz      binary
